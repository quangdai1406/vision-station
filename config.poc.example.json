{
  "site": "[SITE CODE, e.g. AISI1]",
  "line": "[LINE CODE, e.g. L1]",
  "station_id": "[STATION ID as registered in the MES, e.g. vision-poc-1]",
  "part_number": "[PART NUMBER, e.g. 817D-LINER-L]",
  "lot": "[LOT NUMBER for this run]",
  "operator": "[OPERATOR NAME for the shift]",
  "supervisor": "[SUPERVISOR NAME for the shift]",
  "material_handler": "[MATERIAL HANDLER NAME for the shift]",

  "thresholds": {
    "t_low": "[T_LOW from Quality, a number 0..1]",
    "t_img": "[T_IMG from Quality, a number 0..1, >= t_low]"
  },

  "data_dir": "./data",
  "users_file": "./users.json",

  "ui": {
    "host": "127.0.0.1",
    "port": 8000,
    "session_timeout_s": 900
  },

  "mes": {
    "base_url": "[MES BASE URL, e.g. http://127.0.0.1:3000]",
    "token_env": "[NAME OF THE ENV VAR HOLDING THE MES TOKEN, e.g. STATION_MES_TOKEN]",
    "criteria_ids": ["[CRITERION ID from GET /api/machine/criteria/PART]"],
    "class_to_criterion": {
      "scratch": "[CRITERION ID this defect class maps to]"
    },
    "default_criterion_id": null,
    "sync_interval_s": 5,
    "default_bad_disposition": "quarantine",
    "allow_partial_cameras": false
  },

  "cameras": {
    "kind": "opencv",
    "devices": [0],
    "capture_mode": "simultaneous",
    "width": 1920,
    "height": 1080
  },

  "model": {
    "kind": "golden",
    "path": "./golden.npz",
    "version": "golden-poc-1"
  },

  "outputs": {
    "kind": "console"
  },

  "parts": {"mode": "fixed", "models_dir": "./models"},
  "min_flip_s": 2.0
}
